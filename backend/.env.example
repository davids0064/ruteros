# --- PostgreSQL -------------------------------------------------------------
# Local:
DATABASE_URL=postgres://postgres:postgres@localhost:55432/boulder_dev?sslmode=disable
# Railway: lo inyecta el plugin. Usa la URL interna (*.railway.internal), que va
# por la red privada y no necesita SSL. La pública sí exige ?sslmode=require.
DATABASE_POOL_MAX=10

# --- JWT RS256 (RNF-4) ------------------------------------------------------
# Generar con: npm run keys:generate
#
# Local: ficheros en disco.
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
#
# Railway (sin disco persistente): pega el PEM completo, o su base64, en estas
# variables y deja las de arriba sin definir.
#   base64 -i keys/jwt-private.pem | pbcopy
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=boulder-cosetter

# --- Object Storage — S3-compatible (04 §5) ---------------------------------
# Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev   (o tu dominio propio)
S3_BUCKET=boulder-cosetter
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_PRESIGN_TTL=300
S3_MAX_OBJECT_BYTES=8388608
# Token de API S3 del bucket (en R2: "Manage R2 API Tokens").
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- App --------------------------------------------------------------------
# Railway inyecta PORT; en local vale 3000.
PORT=3000
NODE_ENV=development
